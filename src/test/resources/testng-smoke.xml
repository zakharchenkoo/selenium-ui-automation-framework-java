<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="UI Smoke Suite" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="com.qaportfolio.listeners.TestListener"/>
    </listeners>

    <test name="Smoke Tests">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="com.qaportfolio.tests.HomePageTest"/>
            <class name="com.qaportfolio.tests.FormTest"/>
            <class name="com.qaportfolio.tests.WebTablesTest"/>
        </classes>
    </test>
</suite>